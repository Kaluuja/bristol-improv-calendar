{
  "name": "Calendar Event Notifier",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 1 }]
        }
      },
      "id": "e1111111-1111-1111-1111-111111111111",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "method": "GET",
        "url": "https://api.airtable.com/v0/YOUR_AIRTABLE_BASE_ID/Events",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "filterByFormula",
              "value": "AND({Status}=\"Pending\",NOT({Telegram Notified}))"
            },
            {
              "name": "sort[0][field]",
              "value": "Start"
            },
            {
              "name": "sort[0][direction]",
              "value": "asc"
            }
          ]
        },
        "options": {}
      },
      "id": "e2222222-2222-2222-2222-222222222222",
      "name": "Get Pending Events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [220, 300],
      "credentials": {
        "airtableTokenApi": {
          "id": "REPLACE_CREDENTIAL",
          "name": "Airtable API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "records-check",
              "leftValue": "={{ $json.records.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e3333333-3333-3333-3333-333333333333",
      "name": "Any Results?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "jsCode": "const records = $json.records || [];\nreturn records.map(record => ({\n  json: {\n    id: record.id,\n    title: record.fields['Title'] || 'Untitled',\n    venue: record.fields['Venue'] || 'Unknown venue',\n    start: record.fields['Start'] || null,\n    url: record.fields['Tickets URL'] || record.fields['Event URL'] || null,\n  }\n}));"
      },
      "id": "e4444444-4444-4444-4444-444444444444",
      "name": "Split Into Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const id = $json.id;\nconst title = $json.title;\nconst venue = $json.venue;\nconst url = $json.url;\n\nlet dateStr = 'Date unknown';\nif ($json.start) {\n  const d = new Date($json.start);\n  dateStr = d.toLocaleDateString('en-GB', {\n    weekday: 'short',\n    day: 'numeric',\n    month: 'long',\n    year: 'numeric',\n    timeZone: 'Europe/London'\n  }) + ' \\u00b7 ' + d.toLocaleTimeString('en-GB', {\n    hour: '2-digit',\n    minute: '2-digit',\n    timeZone: 'Europe/London'\n  });\n}\n\nconst lines = [\n  '\\ud83c\\udfad *New event pending approval:*',\n  '',\n  '*' + title + '*',\n  '\\ud83d\\udccd ' + venue,\n  '\\ud83d\\udcc5 ' + dateStr,\n];\nif (url) lines.push('\\ud83d\\udd17 [View event](' + url + ')');\nconst text = lines.join('\\n');\n\nconst body = JSON.stringify({\n  chat_id: 'YOUR_TELEGRAM_CHAT_ID',\n  text,\n  parse_mode: 'Markdown',\n  reply_markup: {\n    inline_keyboard: [[\n      { text: '\\u2705 Approve', callback_data: 'approve:' + id },\n      { text: '\\u274c Reject', callback_data: 'reject:' + id },\n      { text: '\\u23f3 Keep pending', callback_data: 'pending:' + id },\n    ]]\n  }\n});\n\nreturn { json: { id, body } };"
      },
      "id": "e5555555-5555-5555-5555-555555555555",
      "name": "Format Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/botYOUR_CALENDAR_BOT_TOKEN/sendMessage",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {}
      },
      "id": "e6666666-6666-6666-6666-666666666666",
      "name": "Send Telegram Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "method": "PATCH",
        "url": "=https://api.airtable.com/v0/YOUR_AIRTABLE_BASE_ID/Events/{{ $('Format Message').item.json.id }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"fields\":{\"Telegram Notified\":true}}",
        "options": {}
      },
      "id": "e7777777-7777-7777-7777-777777777777",
      "name": "Mark as Notified",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1320, 300],
      "credentials": {
        "airtableTokenApi": {
          "id": "REPLACE_CREDENTIAL",
          "name": "Airtable API"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [{ "node": "Get Pending Events", "type": "main", "index": 0 }]
      ]
    },
    "Get Pending Events": {
      "main": [
        [{ "node": "Any Results?", "type": "main", "index": 0 }]
      ]
    },
    "Any Results?": {
      "main": [
        [{ "node": "Split Into Items", "type": "main", "index": 0 }],
        []
      ]
    },
    "Split Into Items": {
      "main": [
        [{ "node": "Format Message", "type": "main", "index": 0 }]
      ]
    },
    "Format Message": {
      "main": [
        [{ "node": "Send Telegram Notification", "type": "main", "index": 0 }]
      ]
    },
    "Send Telegram Notification": {
      "main": [
        [{ "node": "Mark as Notified", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
