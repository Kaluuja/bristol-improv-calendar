{
  "name": "Calendar Approval Handler",
  "nodes": [
    {
      "parameters": {
        "updates": ["callback_query"],
        "additionalFields": {}
      },
      "id": "f1111111-1111-1111-1111-111111111111",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [0, 400],
      "webhookId": "replace-after-import",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_CREDENTIAL",
          "name": "Telegram Calendar Bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const callbackQuery = $json.callback_query;\nconst callbackData = callbackQuery?.data || '';\nconst chatId = String(callbackQuery?.message?.chat?.id || '');\nconst callbackQueryId = callbackQuery?.id;\n\nconst [action, recordId] = callbackData.split(':');\n\nreturn [{\n  json: {\n    action,\n    recordId,\n    chatId,\n    callbackQueryId,\n  }\n}];"
      },
      "id": "f2222222-2222-2222-2222-222222222222",
      "name": "Parse Callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 400]
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": false, "typeValidation": "loose" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "approve",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Approve"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "typeValidation": "loose" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "reject",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Reject"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "typeValidation": "loose" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "pending",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Keep Pending"
            }
          ]
        },
        "fallbackOutput": "extra",
        "options": {}
      },
      "id": "f3333333-3333-3333-3333-333333333333",
      "name": "Route by Action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [440, 400]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "method": "PATCH",
        "url": "=https://api.airtable.com/v0/YOUR_AIRTABLE_BASE_ID/Events/{{ $json.recordId }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"fields\":{\"Status\":\"Approved\"}}",
        "options": {}
      },
      "id": "f4444444-4444-4444-4444-444444444444",
      "name": "Update Approved",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [660, 200],
      "credentials": {
        "airtableTokenApi": {
          "id": "REPLACE_CREDENTIAL",
          "name": "Airtable API"
        }
      }
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "method": "PATCH",
        "url": "=https://api.airtable.com/v0/YOUR_AIRTABLE_BASE_ID/Events/{{ $json.recordId }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"fields\":{\"Status\":\"Rejected\"}}",
        "options": {}
      },
      "id": "f5555555-5555-5555-5555-555555555555",
      "name": "Update Rejected",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [660, 400],
      "credentials": {
        "airtableTokenApi": {
          "id": "REPLACE_CREDENTIAL",
          "name": "Airtable API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const action = $('Parse Callback').item.json.action;\nconst chatId = $('Parse Callback').item.json.chatId;\nconst callbackQueryId = $('Parse Callback').item.json.callbackQueryId;\n\nconst messages = {\n  approve: '\\u2705 Approved \\u2014 will appear on the calendar at next export.',\n  reject:  '\\u274c Rejected \\u2014 removed from the calendar.',\n  pending: '\\u23f3 Left as pending \\u2014 you can review it in Airtable.',\n};\n\nreturn [{\n  json: {\n    replyText: messages[action] || 'Updated.',\n    chatId,\n    callbackQueryId,\n  }\n}];"
      },
      "id": "f6666666-6666-6666-6666-666666666666",
      "name": "Set Reply Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/botYOUR_CALENDAR_BOT_TOKEN/answerCallbackQuery",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"callback_query_id\":\"{{ $json.callbackQueryId }}\",\"text\":\"{{ $json.replyText }}\"}",
        "options": {}
      },
      "id": "f7777777-7777-7777-7777-777777777777",
      "name": "Answer Callback Query",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 400]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.replyText }}",
        "additionalFields": {}
      },
      "id": "f8888888-8888-8888-8888-888888888888",
      "name": "Send Confirmation",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1340, 400],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_CREDENTIAL",
          "name": "Telegram Calendar Bot"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [{ "node": "Parse Callback", "type": "main", "index": 0 }]
      ]
    },
    "Parse Callback": {
      "main": [
        [{ "node": "Route by Action", "type": "main", "index": 0 }]
      ]
    },
    "Route by Action": {
      "main": [
        [{ "node": "Update Approved", "type": "main", "index": 0 }],
        [{ "node": "Update Rejected", "type": "main", "index": 0 }],
        [{ "node": "Set Reply Text", "type": "main", "index": 0 }]
      ]
    },
    "Update Approved": {
      "main": [
        [{ "node": "Set Reply Text", "type": "main", "index": 0 }]
      ]
    },
    "Update Rejected": {
      "main": [
        [{ "node": "Set Reply Text", "type": "main", "index": 0 }]
      ]
    },
    "Set Reply Text": {
      "main": [
        [{ "node": "Answer Callback Query", "type": "main", "index": 0 }]
      ]
    },
    "Answer Callback Query": {
      "main": [
        [{ "node": "Send Confirmation", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
